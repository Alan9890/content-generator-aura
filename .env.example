# Token de tu Bot de Telegram (obtenido con @BotFather)
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui

# Tu ID de usuario de Telegram para que SOLO tú puedas usar y autorizar el bot (opcional pero recomendado)
ALLOWED_TELEGRAM_USER_ID=

# API Key de Google Gemini (para analizar el video multimodalmente y detectar el cut_timestamp exacto)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash

# --- Motor de Arte Manga / Seinen / Baki (RTX 3050 6GB VRAM Local + Fallback) ---
# Opciones: "auto" (prueba A1111/Forge -> ComfyUI -> Gemini/Flux -> Entintado Seinen Local), "a1111", "comfyui", "gemini", "flux_pollinations", "manga_ink"
ART_PROVIDER=auto
SD_WEBUI_URL=http://127.0.0.1:7860
COMFYUI_URL=http://127.0.0.1:8188
MANGA_LORA_TAG=<lora:baki_manga_style:0.85>
IMG2IMG_DENOISING=0.68
MANGA_NEGATIVE_PROMPT=3D render, CGI, smooth skin, realistic photo, clean digital painting, colorful, underwear, soft lighting, bodybuilding pose, blurry, western comic

# --- Parámetros de Ensamblado FFmpeg (Hard Cut + 4-6 frame Screen Shake + 100%->108% Micro-Zoom) ---
MAX_IMPACT_MOMENTS=1
IMPACT_HOLD_SECONDS=0.8
PHONK_VOLUME=0.42
SFX_VOLUME=1.0
ORIGINAL_AUDIO_VOLUME=0.75

# Estilo visual base para los paneles de impacto
DEFAULT_CONTENT_STYLE=Gritty dark seinen manga battle panel, traditional Japanese ink drawing, rough black ink linework, aggressive brush strokes, heavy cross-hatching, extreme chiaroscuro, intense shadows. Style of Kentaro Miura (Berserk), Keisuke Itagaki (Baki the Grappler), and Yusuke Murata.
