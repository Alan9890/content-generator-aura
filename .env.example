# Token de tu Bot de Telegram (obtenido con @BotFather)
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui

# Tu ID de usuario de Telegram para que SOLO tú puedas usar y autorizar el bot (opcional pero recomendado)
ALLOWED_TELEGRAM_USER_ID=

# API Key de Google Gemini (para analizar el video descargado, crear guion/prompts y generar video con Veo)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Modelos de Gemini / Veo
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
VEO_MODEL=veo-2.0-generate-001

# Configuración de Voz (TTS): "edge" (gratis, sin API key) o "elevenlabs"
TTS_PROVIDER=edge
EDGE_TTS_VOICE=es-MX-DaliaNeural

# Opcional: Si usas ElevenLabs para voz clonada/realista
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Estilo / Nicho por defecto para recrear los videos
DEFAULT_CONTENT_STYLE=Video corto dinámico (Reel/Short/TikTok) en español, con un gancho fuerte en los primeros 3 segundos, tono profesional pero cercano, manteniendo la estructura ganadora del video original pero recreado con visuales generados por IA.
